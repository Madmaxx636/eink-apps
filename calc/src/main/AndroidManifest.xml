<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The only network use is the currency converter's "Update rates" button, which asks api.frankfurter.dev
         (European Central Bank reference rates) for the latest exchange rates. Nothing you type is sent. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/InkTheme">
        <activity android:name=".CalcActivity" android:exported="true" android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_CALCULATOR" />
            </intent-filter>
        </activity>
        <activity android:name=".CalcSettings" android:exported="false" android:theme="@style/InkTheme" />
    </application>
</manifest>
